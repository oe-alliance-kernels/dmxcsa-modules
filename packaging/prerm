#!/bin/sh
# Remove the autoload hooks on uninstall. The module itself is left to the next
# reboot rather than force-unloaded while it may be descrambling.
rm -f /etc/init.d/dmxcsa
update-rc.d dmxcsa remove 2>/dev/null || true
if [ -f /lib/systemd/system/dmxcsa.service ]; then
	systemctl disable dmxcsa.service 2>/dev/null || true
	rm -f /lib/systemd/system/dmxcsa.service
	systemctl daemon-reload 2>/dev/null || true
fi
rm -rf /usr/lib/dmxcsa
# also where postinst moved it there itself (boxes with more than one kernel)
rm -f /lib/modules/$(uname -r)/extra/dmxcsa.ko
exit 0
