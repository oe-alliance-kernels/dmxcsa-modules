#!/bin/sh
# dmxcsa autoload on Vu+ 4K boxes: the DVB driver is not a modprobe module but is
# brought up by vuplus-platform-util (rcS S65), and there is no modules-load.d.
# So dmxcsa gets its own init script, ordered right after that one (S66).
set -e
depmod -a 2>/dev/null || true
cat > /etc/init.d/dmxcsa <<'EOS'
#!/bin/sh
[ "$1" = start ] && modprobe dmxcsa
exit 0
EOS
chmod 755 /etc/init.d/dmxcsa
update-rc.d dmxcsa start 66 S . 2>/dev/null || true
modprobe dmxcsa 2>/dev/null || true
exit 0
