#!/bin/sh
# dmxcsa autoload on boxes that load modules via /etc/modules-load.d.
# The DVB driver registers its /dev/dvb nodes with a delay, so a plain
# modules-load.d entry would load dmxcsa too early - it would find no DVB nodes
# and bail. Instead an init script waits for the demux node, then loads it.
# This is timing-robust and also sidesteps BusyBox modprobe (no softdep).
set -e
depmod -a 2>/dev/null || true
cat > /etc/init.d/dmxcsa <<'EOS'
#!/bin/sh
[ "$1" = start ] || exit 0
i=0
while [ ! -e /dev/dvb/adapter0/demux0 ] && [ $i -lt 30 ]; do sleep 1; i=$((i+1)); done
modprobe dmxcsa
exit 0
EOS
chmod 755 /etc/init.d/dmxcsa
update-rc.d dmxcsa start 50 S . 2>/dev/null || true
modprobe dmxcsa 2>/dev/null || true
exit 0
