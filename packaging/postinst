#!/bin/sh
# dmxcsa autoload for every box. A loader script waits for the DVB demux node
# to appear, then loads the module. This is robust whether the DVB driver comes
# up early (modules-load boxes, DVB at S04) or through a platform init (Vu+
# proxy at S65), and it sidesteps BusyBox modprobe (no softdep). With sysvinit
# it is the init script at S66, with systemd (DreamOS) a unit; both run before
# enigma2.
set -e
# a box with more than one kernel gets all its modules in /tmp/dmxcsa: move the
# one whose version magic matches the box's kernel modules into place, drop the rest.
# Where the same kernel version comes with and without kernel mode NEON, the NEON
# module is taken only if the running kernel offers it.
if [ -d /tmp/dmxcsa ]; then
	vm() { tr '\0' '\n' < "$1" | sed -n 's/^vermagic=//p' | head -n 1; }
	neon() { tr '\0' '\n' < "$1" | grep -qx kernel_neon_begin; }
	x=/lib/modules/$(uname -r)
	ref=$(find $x -name '*.ko' ! -name dmxcsa.ko | head -n 1)
	rm -f $x/extra/dmxcsa.ko
	pick= last=
	for k in /tmp/dmxcsa/*.ko; do
		[ -n "$ref" ] && [ "$(vm $k)" = "$(vm $ref)" ] || continue
		if neon $k; then
			last=$k
			grep -qw kernel_neon_begin /proc/kallsyms && { pick=$k; break; }
		else
			[ -n "$pick" ] || pick=$k
		fi
	done
	# without kallsyms there is nothing to tell, a NEON module is better than none
	[ -n "$pick" ] || pick=$last
	if [ -n "$pick" ]; then
		mkdir -p $x/extra
		mv $pick $x/extra/dmxcsa.ko
	fi
	rm -rf /tmp/dmxcsa
	[ -f $x/extra/dmxcsa.ko ] || { echo "dmxcsa: no module for this kernel in the package"; exit 1; }
fi
depmod -a 2>/dev/null || true
# remove any early-load configs left over from testing, so the loader below is
# the only thing that loads the module (an early modules-load would race the DVB
# driver, exactly what the wait loop avoids)
rm -f /etc/modprobe.d/dmxcsa.conf /etc/modules-load.d/*dmxcsa*.conf
# systemd has no update-rc.d on DreamOS and does not read rcS.d. An init script
# of the same name would make systemctl enable fail, so the loader lives
# elsewhere there.
if [ -d /run/systemd/system ]; then
	rm -f /etc/init.d/dmxcsa
	mkdir -p /usr/lib/dmxcsa
	l=/usr/lib/dmxcsa/load
else
	l=/etc/init.d/dmxcsa
fi
cat > $l <<'EOS'
#!/bin/sh
[ "$1" = start ] || exit 0
# drop any early-load config that reappeared, before we load the module
rm -f /etc/modprobe.d/dmxcsa.conf /etc/modules-load.d/*dmxcsa*.conf
i=0
while [ ! -e /dev/dvb/adapter0/demux0 ] && [ $i -lt 30 ]; do sleep 1; i=$((i+1)); done
modprobe dmxcsa
exit 0
EOS
chmod 755 $l
if [ -d /run/systemd/system ]; then
	cat > /lib/systemd/system/dmxcsa.service <<'EOS'
[Unit]
Description=dmxcsa kernel module
DefaultDependencies=no
After=systemd-modules-load.service
Before=enigma2.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/dmxcsa/load start

[Install]
WantedBy=multi-user.target
EOS
	systemctl daemon-reload 2>/dev/null || true
	systemctl enable dmxcsa.service 2>/dev/null || true
else
	update-rc.d dmxcsa start 66 S . 2>/dev/null || true
	# some older images ship no working update-rc.d (only the BusyBox one) and the
	# swallowed error above leaves no start link, so the module never loads at
	# cold boot. Make sure the rcS.d start link exists.
	[ -e /etc/rcS.d/S66dmxcsa ] || ln -sf ../init.d/dmxcsa /etc/rcS.d/S66dmxcsa
fi
modprobe dmxcsa 2>/dev/null || true
exit 0
